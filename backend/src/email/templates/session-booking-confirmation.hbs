<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light"><title>Session booking confirmed</title></head>
<body style="margin:0;padding:0;background:#f4f1ec;color:#27312e;font-family:Arial,Helvetica,sans-serif;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">Your pastoral session has been scheduled. Date, time and booking reference inside.</div>
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f4f1ec;"><tr><td align="center" style="padding:36px 14px;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:580px;background:#fff;">
      <tr><td style="padding:34px 34px 28px;border-top:6px solid #52736b;">
        <p style="margin:0 0 8px;color:#52736b;font:700 12px Arial,sans-serif;letter-spacing:1.2px;text-transform:uppercase;">Appointment scheduled</p>
        <h1 style="margin:0;color:#27312e;font:normal 29px/1.25 Georgia,'Times New Roman',serif;">A time set aside for you</h1>
      </td></tr>
      <tr><td style="padding:0 34px 30px;">
        <p style="margin:0 0 22px;font-size:15px;line-height:1.7;">Hello {{guestName}}, your session with {{ministerTitle}} {{ministerName}} is confirmed.</p>
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f5f6f2;border-top:1px solid #dce2dc;border-bottom:1px solid #dce2dc;">
          <tr><td style="padding:18px 20px 6px;color:#5d6d65;font-size:12px;text-transform:uppercase;">Date</td></tr>
          <tr><td style="padding:0 20px 18px;color:#263d37;font:normal 20px/1.45 Georgia,'Times New Roman',serif;">{{sessionDate}}</td></tr>
          <tr><td style="padding:14px 20px 6px;border-top:1px solid #dce2dc;color:#5d6d65;font-size:12px;text-transform:uppercase;">Time</td></tr>
          <tr><td style="padding:0 20px 18px;color:#263d37;font:normal 20px/1.45 Georgia,'Times New Roman',serif;">{{sessionTime}}</td></tr>
          <tr><td style="padding:14px 20px 6px;border-top:1px solid #dce2dc;color:#5d6d65;font-size:12px;text-transform:uppercase;">Duration</td></tr>
          <tr><td style="padding:0 20px 18px;font-size:15px;">{{durationMinutes}} minutes</td></tr>
        </table>
        {{#if purpose}}<p style="margin:22px 0 0;font-size:14px;line-height:1.7;"><strong>Session purpose</strong><br>{{purpose}}</p>{{/if}}
        {{#if sessionId}}<p style="margin:22px 0 0;color:#5d6d65;font-size:12px;">Booking reference <strong style="color:#263d37;font:700 14px 'Courier New',monospace;">{{sessionId}}</strong></p>{{/if}}
        <p style="margin:24px 0 0;font-size:14px;line-height:1.7;">To reschedule or cancel, reply to this message or contact the church office.</p>
      </td></tr>
      <tr><td style="padding:18px 34px;background:#263d37;color:#fff;font:12px/1.6 Arial,sans-serif;">Watergate Church Global &middot; &copy; {{year}}</td></tr>
    </table>
  </td></tr></table>
</body>
</html>
