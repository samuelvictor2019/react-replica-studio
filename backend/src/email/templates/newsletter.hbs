<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light"><title>{{subject}}</title></head>
<body style="margin:0;padding:0;background:#f3f0e9;color:#2e302d;font-family:Georgia,'Times New Roman',serif;">
  {{#if preheader}}<div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">{{preheader}}</div>{{/if}}
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f3f0e9;"><tr><td align="center" style="padding:34px 14px;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:640px;background:#fff;">
      <tr><td style="padding:16px 34px;background:#315d4b;color:#fff;font:700 11px Arial,Helvetica,sans-serif;letter-spacing:1.6px;text-transform:uppercase;">WaterGate / Community letter</td></tr>
      <tr><td style="padding:34px 34px 24px;border-bottom:1px solid #dfe3dc;"><h1 style="margin:0;color:#263b31;font:normal 32px/1.25 Georgia,'Times New Roman',serif;">{{subject}}</h1>{{#if preheader}}<p style="margin:12px 0 0;color:#5b665e;font:15px/1.6 Arial,Helvetica,sans-serif;">{{preheader}}</p>{{/if}}</td></tr>
      <tr><td style="padding:30px 34px;color:#303833;font:16px/1.8 Arial,Helvetica,sans-serif;">
        <div>{{{htmlContent}}}</div>
      </td></tr>
      <tr><td style="padding:20px 34px;background:#f5f6f2;color:#58645d;font:12px/1.7 Arial,Helvetica,sans-serif;">You are receiving this email because you are connected with Watergate Church Global.<br>&copy; {{year}} Watergate Church Global. All rights reserved.</td></tr>
    </table>
  </td></tr></table>
</body>
</html>
