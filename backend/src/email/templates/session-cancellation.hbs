<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light"><title>Session cancelled</title></head>
<body style="margin:0;padding:0;background:#f2f1f0;color:#2c3031;font-family:Arial,Helvetica,sans-serif;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">Your session on {{sessionDate}} at {{sessionTime}} has been cancelled.</div>
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f2f1f0;"><tr><td align="center" style="padding:38px 14px;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:580px;background:#fff;">
      <tr><td style="padding:30px 34px;background:#4b4543;color:#fff;border-bottom:5px solid #bb7658;">
        <p style="margin:0 0 10px;color:#f0cabb;font-size:12px;font-weight:bold;letter-spacing:1.3px;text-transform:uppercase;">Appointment update</p>
        <h1 style="margin:0;font:normal 28px/1.25 Georgia,'Times New Roman',serif;">Session cancelled</h1>
      </td></tr>
      <tr><td style="padding:30px 34px 34px;">
        <p style="margin:0 0 18px;font-size:15px;line-height:1.75;">Hello {{guestName}}, your session with {{ministerName}} has been cancelled.</p>
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f5f4f2;border-left:4px solid #bb7658;">
          <tr><td style="padding:16px 18px 5px;color:#655d58;font-size:12px;text-transform:uppercase;">Scheduled date</td></tr>
          <tr><td style="padding:0 18px 14px;font-size:16px;line-height:1.5;">{{sessionDate}}</td></tr>
          <tr><td style="padding:12px 18px 5px;border-top:1px solid #e2dfdc;color:#655d58;font-size:12px;text-transform:uppercase;">Scheduled time</td></tr>
          <tr><td style="padding:0 18px 16px;font-size:16px;line-height:1.5;">{{sessionTime}}</td></tr>
        </table>
        {{#if reason}}<p style="margin:20px 0 0;font-size:14px;line-height:1.7;"><strong>Reason</strong><br>{{reason}}</p>{{/if}}
        <p style="margin:22px 0 0;font-size:15px;line-height:1.75;">We are sorry for any inconvenience. Please contact the church office if you would like help arranging another time.</p>
      </td></tr>
      <tr><td style="padding:18px 34px;background:#f5f4f2;color:#655d58;font-size:12px;line-height:1.6;">Watergate Church Global &middot; &copy; {{year}}</td></tr>
    </table>
  </td></tr></table>
</body>
</html>
