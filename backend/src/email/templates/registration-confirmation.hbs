<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light"><title>Registration confirmed: {{title}}</title></head>
<body style="margin:0;padding:0;background:#eef2f5;color:#25313a;font-family:Arial,Helvetica,sans-serif;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">Your place at {{title}} is confirmed. Keep these event details handy.</div>
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#eef2f5;"><tr><td align="center" style="padding:32px 14px;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:620px;background:#fff;">
      <tr><td style="padding:28px 32px;background:#263e52;color:#fff;border-bottom:5px solid #d8a55a;">
        <p style="margin:0 0 8px;color:#f0d4a7;font:700 12px Arial,sans-serif;letter-spacing:1.3px;text-transform:uppercase;">Your event pass</p>
        <h1 style="margin:0;font:normal 28px/1.25 Georgia,'Times New Roman',serif;">Registration confirmed</h1>
      </td></tr>
      {{#if bannerImageUrl}}<tr><td><img src="{{bannerImageUrl}}" alt="Event artwork for {{title}}" width="620" style="display:block;width:100%;max-width:620px;height:auto;border:0;"></td></tr>{{/if}}
      <tr><td style="padding:30px 32px;">
        <p style="margin:0 0 12px;font-size:16px;line-height:1.65;">Hello {{firstName}},</p>
        <p style="margin:0 0 24px;font-size:16px;line-height:1.65;">You are registered for <strong>{{title}}</strong>. Your place is reserved; here are the details to plan your visit.</p>
        <h2 style="margin:0;padding:15px 18px;background:#f2f5f6;color:#263e52;font:700 19px/1.4 Arial,sans-serif;">{{title}}</h2>
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border:1px solid #dce3e7;">
          <tr><td style="padding:14px 18px;border-bottom:1px solid #dce3e7;color:#52616a;font-size:13px;width:120px;">Date</td><td style="padding:14px 18px;border-bottom:1px solid #dce3e7;font-size:15px;">{{formatDate startDate}}{{#if endDate}} – {{formatDate endDate}}{{/if}}</td></tr>
          <tr><td style="padding:14px 18px;border-bottom:1px solid #dce3e7;color:#52616a;font-size:13px;">Location</td><td style="padding:14px 18px;border-bottom:1px solid #dce3e7;font-size:15px;">{{location}}</td></tr>
          {{#if selectedDays}}<tr><td style="padding:14px 18px;color:#52616a;font-size:13px;vertical-align:top;">Selected dates</td><td style="padding:14px 18px;font-size:15px;line-height:1.8;">{{#each selectedDays}}{{formatDate this}}{{#unless @last}}<br>{{/unless}}{{/each}}</td></tr>{{/if}}
        </table>
        {{#if ticketNumber}}<p style="margin:20px 0 0;color:#52616a;font-size:13px;">Ticket number<br><strong style="display:inline-block;margin-top:5px;color:#263e52;font:700 18px/1.4 'Courier New',monospace;">{{ticketNumber}}</strong></p>{{/if}}
        {{#if description}}<p style="margin:22px 0 0;padding:16px 18px;background:#f8f6f1;border-left:3px solid #d8a55a;font-size:14px;line-height:1.7;">{{description}}</p>{{/if}}
        {{#if actionUrl}}<p style="margin:26px 0 0;"><a href="{{actionUrl}}" style="display:inline-block;padding:14px 20px;background:#17615b;color:#fff;text-decoration:underline;font-weight:bold;line-height:1.4;">View event details</a></p>{{/if}}
        <p style="margin:24px 0 0;font-size:14px;line-height:1.7;">Need to change your reservation? Reply to this email and our team will help.</p>
      </td></tr>
      <tr><td style="padding:18px 32px;background:#f2f5f6;color:#52616a;font-size:12px;line-height:1.6;">Watergate Church Global &middot; &copy; {{year}}. Please keep this message for your records.</td></tr>
    </table>
  </td></tr></table>
</body>
</html>
