<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light"><title>Upcoming program: {{programName}}</title></head>
<body style="margin:0;padding:0;background:#f4f1e9;color:#27312e;font-family:Arial,Helvetica,sans-serif;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">{{programName}} is coming up on {{startDate}}. Find out what to expect.</div>
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f4f1e9;"><tr><td align="center" style="padding:30px 14px;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:620px;background:#fff;">
      {{#if bannerImageUrl}}<tr><td><img src="{{bannerImageUrl}}" alt="Program artwork for {{programName}}" width="620" style="display:block;width:100%;max-width:620px;height:auto;border:0;"></td></tr>{{/if}}
      <tr><td style="padding:24px 34px 8px;color:#7b5b26;font-size:12px;font-weight:bold;letter-spacing:1.4px;text-transform:uppercase;">WaterGate invites you</td></tr>
      <tr><td style="padding:0 34px 28px;"><h1 style="margin:0;color:#243d36;font:normal 34px/1.2 Georgia,'Times New Roman',serif;">{{programName}}</h1></td></tr>
      <tr><td style="padding:0 34px 30px;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f3f5ef;">
          <tr><td width="50%" style="padding:18px 20px;border-right:1px solid #dce3d8;vertical-align:top;"><p style="margin:0 0 6px;color:#586a5d;font-size:11px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;">When</p><p style="margin:0;color:#243d36;font-size:16px;line-height:1.5;">{{startDate}}</p></td>
          <td width="50%" style="padding:18px 20px;vertical-align:top;"><p style="margin:0 0 6px;color:#586a5d;font-size:11px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;">Where</p><p style="margin:0;color:#243d36;font-size:16px;line-height:1.5;">{{location}}</p></td></tr>
        </table>
        <p style="margin:24px 0 0;font-size:15px;line-height:1.75;">{{description}}</p>
        {{#if actionUrl}}<p style="margin:25px 0 0;"><a href="{{actionUrl}}" style="display:inline-block;padding:14px 20px;background:#a45332;color:#fff;text-decoration:underline;font-weight:bold;line-height:1.4;">Explore the program</a></p>{{/if}}
        <p style="margin:24px 0 0;color:#52615a;font-size:14px;line-height:1.7;">Bring someone along and join us. We would be glad to see you there.</p>
      </td></tr>
      <tr><td style="padding:17px 34px;border-top:1px solid #e1e5df;color:#59675f;font-size:12px;line-height:1.6;">Watergate Church Global &middot; &copy; {{year}}</td></tr>
    </table>
  </td></tr></table>
</body>
</html>
