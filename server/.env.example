# Runtime
NODE_ENV=production
APP_NAME=WaterGate Church API

# PostgreSQL
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Authentication
JWT_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Redis / BullMQ
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail (configure the provider/credentials used by your current backend deployment)
MAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@watergatechurch.org
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google / Sessions
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_RCS_API_KEY=

# Notifications
TERMII_API_KEY=
TERMII_SENDER_ID=WGC

# YouTube
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
